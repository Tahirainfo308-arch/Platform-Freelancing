# Server Configuration
AME_HOST=0.0.0.0
AME_PORT=8000
AME_DEBUG=true

# Security & Authentication
# API Key that the main marketplace must send in the header (X-AME-API-Key)
AME_API_KEY=your_ame_secure_api_key_here
# Key used to sign webhook payloads sent to the main marketplace
AME_WEBHOOK_SECRET=your_ame_webhook_signing_secret_here

# Databases
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ame_db
REDIS_URL=redis://localhost:6379/0

# External AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Main Marketplace Configurations (for webhook dispatch)
MARKETPLACE_BASE_URL=http://localhost:3000
MARKETPLACE_WEBHOOK_PATH=/api/webhooks/ame
